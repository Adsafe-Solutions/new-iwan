# Copy to .env.local, then SOPS-encrypt it before committing. Vite reads
# .env.development for `npm run dev`, .env.production for production builds,
# and .env.local in every mode — see https://vite.dev/guide/env-and-mode.
#
# Vite normally exposes only VITE_* keys. vite.config.js makes the Turnstile
# site key public explicitly; it never exposes TURNSTILE_SECRET_KEY.

# dev | prod. Purely descriptive; nothing branches on it today beyond the
# footer/debug affordances you might add.
VITE_ENVIRONMENT=dev

# Canonical origin for this deployment, used for absolute links and meta tags.
VITE_SITE_URL=http://localhost:5173

# Feature switches. Unset means "use the default in src/config/sections.js",
# so an environment only has to name what it wants different.
#   VITE_HOME_HERO         v1 | v2
#   VITE_PROGRAMME_ABOUT   v1 | v2
#   VITE_TOPBAR            true | false
VITE_HOME_HERO=
VITE_PROGRAMME_ABOUT=
VITE_TOPBAR=

# Lowercase ISO 3166-1 alpha-2 code served at the unprefixed root.
# Must match an entry in src/config/countries.js.
VITE_DEFAULT_COUNTRY=in

# Cloudflare Turnstile. The site key is public browser configuration. The
# secret is server-only and currently reserved for a future Siteverify handler.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated hostnames accepted by server-side Turnstile verification.
# Production must not include localhost or 127.0.0.1.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Server-only Resend configuration. Create two Resend Segments named IN and CA,
# then copy their IDs here. Broadcasts sent to those segments must include
# {{{RESEND_UNSUBSCRIBE_URL}}} in their email template.
RESEND_API_KEY=
RESEND_SEGMENT_IN=
RESEND_SEGMENT_CA=

# Transactional form delivery through Resend. RESEND_FROM_EMAIL must use a
# domain verified in Resend, for example "Iwan Website <forms@iwan.community>".
# Regional recipients override the generic fallback when present.
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_TO_EMAIL_IN=
CONTACT_TO_EMAIL_CA=
EVENTS_TO_EMAIL=
EVENTS_TO_EMAIL_IN=
EVENTS_TO_EMAIL_CA=
VITE_CMS_API_URL=https://iwan-cms-api.onrender.com
