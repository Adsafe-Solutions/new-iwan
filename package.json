{
  "name": "iwan-community",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "preview:cf": "npm run build:dev && wrangler dev --config wrangler.dev.toml",
    "deploy:dev": "npm run build:dev && wrangler deploy --config wrangler.dev.toml",
    "deploy:prod": "npm run build:prod && wrangler deploy --config wrangler.toml",
    "prepare": "sh scripts/install-git-hooks.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wrangler": "^4.125.0"
  }
}
